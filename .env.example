# ---------------------------------------------------------------------------
# Two files, because Prisma and Next read different ones.
#
#   .env        DATABASE_URL only — the Prisma CLI reads this.
#   .env.local  secrets — Next reads this, and it is gitignored.
#
# `npm run setup` creates .env for you. Copy the block below into .env.local.
# ---------------------------------------------------------------------------

# Gemini API key. SERVER-SIDE ONLY — it is never sent to the browser.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Model for the Search-grounded Research Mode pass.
# Must support the googleSearch tool. Defaults to GEMINI_MODEL.
GEMINI_RESEARCH_MODEL=gemini-2.5-flash

# Signs demo session cookies. Any long random string (16+ chars).
# REQUIRED in production — the server refuses to start without it.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Gemini calls allowed per user per UTC day. Defaults to 120.
DAILY_MODEL_CALLS=120

# Also needed here if you run `next build` without .env present.
DATABASE_URL="file:./dev.db"
